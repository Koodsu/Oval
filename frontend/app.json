{
  "expo": {
    "name": "Bridge - Campus Life",
    "slug": "bridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "bridge",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6d28d9",
          "sounds": []
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bradyvb.bridgeapp",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:joinbridgeapp.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Bridge uses your location to show pods forming near you on campus.",
        "NSPhotoLibraryUsageDescription": "Bridge lets you choose a photo from your library for your profile or club avatar."
      }
    },
    "android": {
      "package": "com.bradyvb.bridgeapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "joinbridgeapp.com",
              "pathPrefix": "/pod"
            },
            {
              "scheme": "https",
              "host": "joinbridgeapp.com",
              "pathPrefix": "/clubs"
            },
            {
              "scheme": "https",
              "host": "joinbridgeapp.com",
              "pathPrefix": "/users"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9253c09e-c729-4b63-8c86-692c17cc9919"
      }
    }
  }
}
