{
  "expo": {
    "name": "Oval",
    "slug": "oval",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/oval-open-1024.png",
    "userInterfaceStyle": "automatic",
    "scheme": "oval",
    "plugins": [
      "@sentry/react-native/expo",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/oval-open-1024-transparent.png",
          "color": "#EF5A63",
          "sounds": []
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/oval-open-1024-transparent.png",
          "resizeMode": "contain",
          "backgroundColor": "#251018"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bradyvb.ovalapp",
      "associatedDomains": [
        "applinks:www.theovalapp.com",
        "applinks:theovalapp.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Oval uses your location to show pods forming near you on campus.",
        "NSPhotoLibraryUsageDescription": "Oval lets you choose a photo from your library for your profile or club avatar."
      }
    },
    "android": {
      "package": "com.bradyvb.ovalapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/oval-open-1024-transparent.png",
        "backgroundColor": "#251018"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.theovalapp.com",
              "pathPrefix": "/pod"
            },
            {
              "scheme": "https",
              "host": "www.theovalapp.com",
              "pathPrefix": "/clubs"
            },
            {
              "scheme": "https",
              "host": "www.theovalapp.com",
              "pathPrefix": "/users"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/brand/oval-open-1024.png"
    },
    "extra": {
      "eas": {
        "projectId": "8080880f-a229-46db-853e-88035b0b7c9f"
      }
    },
    "owner": "bradyv"
  }
}
