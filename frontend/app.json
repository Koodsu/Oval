{
  "expo": {
    "name": "Bridge - Campus Life",
    "slug": "bridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/oval-app-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bridge",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/oval-app-icon.png",
          "color": "#C73B22",
          "sounds": []
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/oval-app-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#C73B22"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bradyvb.bridgeapp",
      "associatedDomains": [
        "applinks:www.joinbridgeapp.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Bridge uses your location to show pods forming near you on campus.",
        "NSPhotoLibraryUsageDescription": "Bridge lets you choose a photo from your library for your profile or club avatar."
      }
    },
    "android": {
      "package": "com.bradyvb.bridgeapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/oval-app-icon.png",
        "backgroundColor": "#C73B22"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.joinbridgeapp.com",
              "pathPrefix": "/pod"
            },
            {
              "scheme": "https",
              "host": "www.joinbridgeapp.com",
              "pathPrefix": "/clubs"
            },
            {
              "scheme": "https",
              "host": "www.joinbridgeapp.com",
              "pathPrefix": "/users"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/brand/oval-app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9253c09e-c729-4b63-8c86-692c17cc9919"
      }
    }
  }
}
