# Backend API (see README)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase project (same DB as Prisma when hosted on Supabase). Required for pod chat Realtime.
# Enable Realtime on the "Message" table in Supabase Dashboard → Database → Replication.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional crash reporting. Set the DSN as an EAS environment secret for release builds.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENV=development
