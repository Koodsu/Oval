# Backend API (see README)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase project (same DB as Prisma when hosted on Supabase). Required for pod chat Realtime.
# Enable Realtime on the "Message" table in Supabase Dashboard → Database → Replication.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Crash reporting (Sentry). Leaving the DSN empty disables Sentry entirely —
# src/lib/monitoring.ts no-ops, and nothing is sent off device. Leave it empty
# locally unless you are specifically testing crash reporting.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENV=development

# Source map upload for readable stack traces. Build-time only — never bundled
# into the app. The org and project slugs live in app.json under the
# @sentry/react-native/expo plugin config, so the only value needed here is the
# auth token, set as an EAS secret:
#   eas env:create --name SENTRY_AUTH_TOKEN --value <token> --environment production --environment preview --visibility secret
# If SENTRY_AUTH_TOKEN is missing the build still succeeds, but stack traces
# stay minified. See docs/PLAY_DATA_SAFETY_2026-08.md before changing what
# Sentry collects — it affects the Play Data Safety declaration.
SENTRY_AUTH_TOKEN=
