generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid())
  name                    String
  email                   String    @unique
  password                String
  createdAt               DateTime  @default(now())
  verifiedUniversity      Boolean   @default(false)
  emailVerifyCode         String?
  emailVerifyExpiry       DateTime?
  pushToken               String?
  notificationPreferences String?

  podMembers        PodMember[]
  messages          Message[]
  createdPods       Pod[]
  blocksGiven       Block[]        @relation("Blocker")
  blocksReceived    Block[]        @relation("Blocked")
  reportsGiven      Report[]       @relation("ReportReporter")
  reportsReceived   Report[]       @relation("ReportTarget")
  noShowsGiven      NoShowReport[] @relation("NoShowReporter")
  noShowsReceived   NoShowReport[] @relation("NoShowTarget")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Activity {
  id              String   @id @default(uuid())
  title           String
  description     String
  category        String   @default("Social")
  defaultLocation String
  createdAt       DateTime @default(now())

  pods Pod[]
}

// PodStatus values: "FORMING" | "LOCKED" | "COMPLETED"

model Pod {
  id           String   @id @default(uuid())
  activityId   String
  meetupTime   DateTime
  location     String
  locationType String   @default("public") // "public" | "private"
  minMembers   Int      @default(2)
  maxMembers   Int      @default(4)
  status       String   @default("FORMING")
  creatorId    String?
  createdAt    DateTime @default(now())

  activity      Activity       @relation(fields: [activityId], references: [id])
  creator       User?          @relation(fields: [creatorId], references: [id])
  members       PodMember[]
  messages      Message[]
  reports       Report[]
  noShowReports NoShowReport[]
}

model PodMember {
  id          String    @id @default(uuid())
  podId       String
  userId      String
  joinedAt    DateTime  @default(now())
  confirmedAt DateTime?

  pod  Pod  @relation(fields: [podId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([podId, userId])
}

model Message {
  id        String   @id @default(uuid())
  podId     String
  userId    String
  content   String
  createdAt DateTime @default(now())

  pod     Pod     @relation(fields: [podId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  reports Report[]
}

model Report {
  id           String    @id @default(uuid())
  reporterId   String
  targetUserId String?
  podId        String?
  messageId    String?
  reason       String
  details      String?
  status       String    @default("OPEN")
  adminNotes   String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  reporter User     @relation("ReportReporter", fields: [reporterId], references: [id])
  target   User?    @relation("ReportTarget", fields: [targetUserId], references: [id])
  pod      Pod?     @relation(fields: [podId], references: [id])
  message  Message? @relation(fields: [messageId], references: [id])

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([podId])
  @@index([messageId])
  @@index([targetUserId])
}

model NoShowReport {
  id           String   @id @default(uuid())
  podId        String
  reporterId   String
  targetUserId String
  createdAt    DateTime @default(now())

  pod      Pod  @relation(fields: [podId], references: [id], onDelete: Cascade)
  reporter User @relation("NoShowReporter", fields: [reporterId], references: [id])
  target   User @relation("NoShowTarget", fields: [targetUserId], references: [id])

  @@unique([podId, reporterId, targetUserId])
  @@index([targetUserId])
  @@index([podId])
}
