generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String    @id @default(uuid())
  name                    String
  firstName               String
  lastName                String    @default("")
  email                   String    @unique
  password                String
  createdAt               DateTime  @default(now())
  verifiedUniversity      Boolean   @default(false)
  isClubReviewer          Boolean   @default(false)
  emailVerifyCode         String?
  emailVerifyExpiry       DateTime?
  passwordResetCode       String?
  passwordResetExpiry     DateTime?
  tokenVersion            Int       @default(0)
  accountStatus           String    @default("ACTIVE")
  accountStatusChangedAt  DateTime?
  moderationReason        String?
  termsVersion            String?
  termsAcceptedAt         DateTime?
  ageAttestedAt           DateTime?
  pushToken               String?
  notificationPreferences String?
  avatarUrl               String?
  classYear               String?
  major                   String?
  bio                     String?
  clubs                   String?
  instagramHandle         String?
  interestTags            String?
  purpose                 String?
  /// JSON array of campus zone names
  campusZones             String?
  clubInterests           String?

  podMembers             PodMember[]
  messages               Message[]
  messageReactions       MessageReaction[]
  directMessageReactions DirectMessageReaction[]
  createdPods            Pod[]
  blocksGiven            Block[]                 @relation("Blocker")
  blocksReceived         Block[]                 @relation("Blocked")
  reportsGiven           Report[]                @relation("ReportReporter")
  reportsReceived        Report[]                @relation("ReportTarget")
  noShowsGiven           NoShowReport[]          @relation("NoShowReporter")
  noShowsReceived        NoShowReport[]          @relation("NoShowTarget")
  recaps                 PodRecap[]
  waitlistEntries        PodWaitlist[]

  sentFriendRequests     FriendRequest[]       @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[]       @relation("FriendRequestReceiver")
  friendshipsAsA         Friendship[]          @relation("FriendshipUserA")
  friendshipsAsB         Friendship[]          @relation("FriendshipUserB")
  dmThreadsAsA           DirectMessageThread[] @relation("DMThreadUserA")
  dmThreadsAsB           DirectMessageThread[] @relation("DMThreadUserB")
  directMessages         DirectMessage[]
  sentPodInvites         PodInvite[]           @relation("PodInviteSender")
  receivedPodInvites     PodInvite[]           @relation("PodInviteReceiver")
  clubsCreated           Club[]                @relation("ClubCreator")
  clubMemberships        ClubMember[]
  clubRolesCreated       ClubRole[]            @relation("ClubRoleCreator")
  clubMeetingsCreated    ClubMeeting[]         @relation("MeetingCreator")
  clubMeetingAttendees   ClubMeetingAttendee[]
  clubAnnouncements      ClubAnnouncement[]
  clubMessages           ClubMessage[]
  clubOfficerMessages    ClubOfficerMessage[]
  clubChannelReadStates  ClubChannelReadState[]
  clubFollows            ClubFollower[]
  clubClaims             ClubClaim[]
  clubApplications       ClubApplication[]
  activityRequests       ActivityRequest[]
  analyticsEvents        AnalyticsEvent[]
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Activity {
  id              String   @id @default(uuid())
  title           String
  description     String
  category        String   @default("Social")
  defaultLocation String
  createdAt       DateTime @default(now())

  pods Pod[]
}

model ActivityRequest {
  id              String   @id @default(uuid())
  userId          String
  title           String
  description     String?
  category        String
  defaultLocation String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewerId      String?
  reviewNote      String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// PodStatus values: "FORMING" | "LOCKED" | "COMPLETED"

model Pod {
  id                   String    @id @default(uuid())
  activityId           String
  meetupTime           DateTime
  location             String
  locationType         String    @default("public") // "public" | "private"
  minMembers           Int       @default(2)
  maxMembers           Int       @default(4)
  status               String    @default("FORMING")
  creatorId            String?
  createdAt            DateTime  @default(now())
  meetupReminderSentAt DateTime?
  recapNotifiedAt      DateTime?
  latitude             Float?
  longitude            Float?

  activity      Activity       @relation(fields: [activityId], references: [id], onDelete: Restrict)
  creator       User?          @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  members       PodMember[]
  messages      Message[]
  reports       Report[]
  noShowReports NoShowReport[]
  podInvites    PodInvite[]
  recaps        PodRecap[]
  waitlist      PodWaitlist[]

  @@index([activityId])
  @@index([creatorId])
}

model PodMember {
  id          String    @id @default(uuid())
  podId       String
  userId      String
  joinedAt    DateTime  @default(now())
  confirmedAt DateTime?

  pod  Pod  @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(uuid())
  podId     String
  userId    String
  content   String
  replyToId String?
  createdAt DateTime @default(now())

  pod       Pod               @relation(fields: [podId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo   Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("MessageReplies")
  reports   Report[]
  reactions MessageReaction[]

  @@index([podId, createdAt])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Report {
  id                    String    @id @default(uuid())
  reporterId            String?
  targetUserId          String?
  podId                 String?
  messageId             String?
  directMessageId       String?
  clubId                String?
  clubMessageId         String?
  clubOfficerMessageId  String?
  clubAnnouncementId    String?
  targetType            String?
  reason                String
  severity              String    @default("P2")
  details               String?
  reportedContent       String?
  status                String    @default("OPEN")
  adminNotes            String?
  moderationEmailSentAt DateTime?
  contentRemovedAt      DateTime?
  accountAction         String?
  accountActionAt       DateTime?
  createdAt             DateTime  @default(now())
  resolvedAt            DateTime?

  reporter User?    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  target   User?    @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  pod      Pod?     @relation(fields: [podId], references: [id], onDelete: SetNull)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([severity, createdAt])
  @@index([podId])
  @@index([messageId])
  @@index([directMessageId])
  @@index([clubId])
  @@index([clubMessageId])
  @@index([clubOfficerMessageId])
  @@index([clubAnnouncementId])
  @@index([targetUserId])
}

model BannedIdentity {
  id        String   @id @default(uuid())
  emailHash String   @unique
  reason    String?
  reportId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AbuseEvent {
  id         String   @id @default(uuid())
  action     String
  identifier String
  createdAt  DateTime @default(now())

  @@index([action, identifier, createdAt])
  @@index([createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String?
  name       String
  properties Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model NoShowReport {
  id           String   @id @default(uuid())
  podId        String
  reporterId   String
  targetUserId String
  createdAt    DateTime @default(now())

  pod      Pod  @relation(fields: [podId], references: [id], onDelete: Cascade)
  reporter User @relation("NoShowReporter", fields: [reporterId], references: [id])
  target   User @relation("NoShowTarget", fields: [targetUserId], references: [id])

  @@unique([podId, reporterId, targetUserId])
  @@index([targetUserId])
  @@index([podId])
}

// FriendRequestStatus values: "PENDING" | "ACCEPTED" | "DECLINED" | "CANCELLED"

model FriendRequest {
  id          String    @id @default(uuid())
  senderId    String
  receiverId  String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DirectMessageThread {
  id              String    @id @default(uuid())
  userAId         String
  userBId         String
  userALastReadAt DateTime?
  userBLastReadAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userA    User            @relation("DMThreadUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User            @relation("DMThreadUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DirectMessage {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  content   String
  replyToId String?
  createdAt DateTime @default(now())

  thread    DirectMessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User                    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo   DirectMessage?          @relation("DMReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   DirectMessage[]         @relation("DMReplies")
  reactions DirectMessageReaction[]

  @@index([threadId, createdAt])
  @@index([senderId])
}

model DirectMessageReaction {
  id              String   @id @default(uuid())
  directMessageId String
  userId          String
  emoji           String
  createdAt       DateTime @default(now())

  directMessage DirectMessage @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([directMessageId, userId, emoji])
  @@index([directMessageId])
}

// PodInviteStatus values: "PENDING" | "ACCEPTED" | "DECLINED" | "EXPIRED"

model PodInvite {
  id          String    @id @default(uuid())
  podId       String
  senderId    String
  receiverId  String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  pod      Pod  @relation(fields: [podId], references: [id], onDelete: Cascade)
  sender   User @relation("PodInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("PodInviteReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([podId, senderId, receiverId])
  @@index([receiverId])
  @@index([podId])
  @@index([senderId])
}

// PodRecap: post-meetup rating (1 = thumbs down, 2 = neutral, 3 = thumbs up)
model PodRecap {
  id        String   @id @default(uuid())
  podId     String
  userId    String
  rating    Int
  note      String?
  createdAt DateTime @default(now())

  pod  Pod  @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
  @@index([podId])
  @@index([userId])
}

model PodWaitlist {
  id         String    @id @default(uuid())
  podId      String
  userId     String
  position   Int
  status     String    @default("WAITING") // WAITING, NOTIFIED, EXPIRED, JOINED
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  pod  Pod  @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
  @@index([podId, status])
  @@index([userId])
}

model Club {
  id                 String   @id @default(uuid())
  name               String
  description        String
  category           String
  emoji              String   @default("🎓")
  avatarUrl          String?
  isVerified         Boolean  @default(false) // legacy, dropped in Phase 4 (see CLUB_LIFECYCLE_IMPLEMENTATION.md)
  isPublic           Boolean  @default(true)   // legacy, dropped in Phase 4
  university         String   @default("OSU")
  createdById        String
  officerPermissions String   @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // --- Club lifecycle: four orthogonal axes ---
  isDiscoverable     Boolean  @default(false)
  verification       String   @default("UNVERIFIED") // UNVERIFIED | PENDING_REVIEW | VERIFIED
  joinPolicy         String   @default("OPEN") // OPEN | REQUEST | APPLICATION | INVITE_ONLY
  status             String   @default("ACTIVE") // ACTIVE | SUSPENDED | ARCHIVED

  // verification metadata
  verificationMethod String? // INSTAGRAM | OFFICIAL_EMAIL | DIRECTORY | MANUAL
  verifiedAt         DateTime?
  verifiedByUserId   String?
  instagramHandle    String?
  officialEmail      String?
  lastReaffirmedAt   DateTime?

  // bookkeeping
  discoverableSince  DateTime?
  suspendedAt        DateTime?
  suspendedReason    String?

  createdBy       User                 @relation("ClubCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members         ClubMember[]
  roles           ClubRole[]
  meetings        ClubMeeting[]
  announcements   ClubAnnouncement[]
  messages        ClubMessage[]
  officerMessages ClubOfficerMessage[]
  channels        ClubChannel[]
  followers       ClubFollower[]
  claims          ClubClaim[]
  invites         ClubInvite[]
  appCycles       ClubApplicationCycle[]

  @@index([isPublic, category])
  @@index([isDiscoverable, status, category])
  @@index([university, isDiscoverable])
}

model ClubChannel {
  id             String   @id @default(uuid())
  clubId         String
  kind           String   @default("CUSTOM") // ANNOUNCEMENTS | GENERAL | OFFICERS | CUSTOM
  name           String
  description    String?
  /// JSON array of ClubRole ids; null/[] = every member (CUSTOM channels only)
  allowedRoleIds String?
  /// JSON array of User ids; null/[] = no specific member gate (CUSTOM channels only)
  allowedUserIds String?
  position       Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  club       Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  messages   ClubMessage[]
  readStates ClubChannelReadState[]

  @@unique([clubId, name])
  @@index([clubId, position])
}

model ClubChannelReadState {
  id         String   @id @default(uuid())
  channelId  String
  userId     String
  lastReadAt DateTime @default(now())

  channel ClubChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model ClubMember {
  id       String   @id @default(uuid())
  clubId   String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  club        Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRoles ClubMemberRole[]

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

model ClubRole {
  id               String   @id @default(uuid())
  clubId           String
  name             String
  permissions      String   @default("[]")
  /// Named accent from the app palette (e.g. "blue", "violet"); null = neutral
  color            String?
  isSelfAssignable Boolean  @default(false)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  club        Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("ClubRoleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments ClubMemberRole[]

  @@unique([clubId, name])
  @@index([clubId])
}

model ClubMemberRole {
  id           String   @id @default(uuid())
  clubId       String
  memberId     String
  roleId       String
  assignedById String
  createdAt    DateTime @default(now())

  member ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   ClubRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([clubId])
  @@index([roleId])
}

model ClubMeeting {
  id                 String    @id @default(uuid())
  clubId             String
  title              String
  description        String?
  location           String
  meetingTime        DateTime
  isPublic           Boolean   @default(true)
  visibility         String    @default("PUBLIC")
  targetRoleIds      String?
  createdById        String
  createdAt          DateTime  @default(now())
  latitude           Float?
  longitude          Float?
  attendanceOpen     Boolean   @default(false)
  attendanceCode     String?
  rsvpReminderSentAt DateTime?
  rsvpReminderStatus String?
  rsvpReminderCount  Int       @default(0)
  rsvpReminderError  String?

  club      Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User                  @relation("MeetingCreator", fields: [createdById], references: [id])
  attendees ClubMeetingAttendee[]

  @@index([clubId, meetingTime])
  @@index([meetingTime])
  @@index([createdById])
}

model ClubMeetingAttendee {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  status    String   @default("GOING")
  createdAt DateTime @default(now())

  meeting ClubMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

model ClubAnnouncement {
  id            String   @id @default(uuid())
  clubId        String
  userId        String
  content       String
  visibility    String   @default("PUBLIC")
  targetRoleIds String?
  createdAt     DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

model ClubMessage {
  id             String   @id @default(uuid())
  clubId         String
  /// Null = the built-in General channel; otherwise a CUSTOM ClubChannel id
  channelId      String?
  userId         String
  content        String
  /// JSON array of ClubRole ids pinged in this message
  mentionRoleIds String?
  createdAt      DateTime @default(now())

  club    Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  channel ClubChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([channelId, createdAt])
  @@index([userId])
}

model ClubOfficerMessage {
  id        String   @id @default(uuid())
  clubId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([userId])
}

// ---------- Club lifecycle & verification ----------

/// Public follow — audience, separate from membership.
model ClubFollower {
  id        String   @id @default(uuid())
  clubId    String
  userId    String
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

/// A verification attempt by a member who claims to be an officer.
model ClubClaim {
  id            String    @id @default(uuid())
  clubId        String
  userId        String
  method        String // INSTAGRAM | OFFICIAL_EMAIL | DIRECTORY | MANUAL
  handleOrEmail String
  challengeCode String
  status        String    @default("PENDING") // PENDING | PROOF_SENT | APPROVED | REJECTED | EXPIRED
  reviewerId    String?
  reviewNote    String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  resolvedAt    DateTime?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId, status])
  @@index([status, createdAt])
}

/// Invite links for the private (pre-threshold) stage.
model ClubInvite {
  id          String    @id @default(uuid())
  clubId      String
  code        String    @unique
  createdById String
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

/// In-app applications to JOIN a club (the Builders flow).
model ClubApplicationCycle {
  id            String    @id @default(uuid())
  clubId        String
  title         String
  questionsJson String // customizable form schema
  status        String    @default("DRAFT") // DRAFT | OPEN | CLOSED
  opensAt       DateTime?
  closesAt      DateTime?
  createdAt     DateTime  @default(now())

  club         Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  applications ClubApplication[]

  @@index([clubId, status])
}

model ClubApplication {
  id          String   @id @default(uuid())
  cycleId     String
  userId      String
  answersJson String
  stage       String   @default("APPLIED") // APPLIED | INTERVIEW | ACCEPTED | REJECTED | WITHDRAWN
  reviewNote  String?
  createdAt   DateTime @default(now())

  cycle ClubApplicationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cycleId, userId])
  @@index([cycleId, stage])
}
