generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  podMembers  PodMember[]
  messages    Message[]
  createdPods Pod[]
}

model Activity {
  id              String   @id @default(uuid())
  title           String
  description     String
  category        String   @default("Social")
  defaultLocation String
  createdAt       DateTime @default(now())

  pods Pod[]
}

// PodStatus values: "FORMING" | "LOCKED" | "COMPLETED"

model Pod {
  id           String   @id @default(uuid())
  activityId   String
  meetupTime   DateTime
  location     String
  locationType String   @default("public") // "public" | "private"
  minMembers   Int      @default(2)
  maxMembers   Int      @default(4)
  status       String   @default("FORMING")
  creatorId    String?
  createdAt    DateTime @default(now())

  activity Activity    @relation(fields: [activityId], references: [id])
  creator  User?       @relation(fields: [creatorId], references: [id])
  members  PodMember[]
  messages Message[]
}

model PodMember {
  id       String   @id @default(uuid())
  podId    String
  userId   String
  joinedAt DateTime @default(now())

  pod  Pod  @relation(fields: [podId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([podId, userId])
}

model Message {
  id        String   @id @default(uuid())
  podId     String
  userId    String
  content   String
  createdAt DateTime @default(now())

  pod  Pod  @relation(fields: [podId], references: [id])
  user User @relation(fields: [userId], references: [id])
}
