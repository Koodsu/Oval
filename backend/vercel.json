{
  "version": 2,
  "buildCommand": "npx prisma migrate deploy && npm run build",
  "env": {
    "TZ": "America/New_York"
  },
  "functions": {
    "src/server.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/cron/maintenance",
      "schedule": "0 17 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ]
}
