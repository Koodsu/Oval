# Supabase Postgres — pooler URL for runtime (transaction mode, port 6543)
# Find this in: Supabase Dashboard → Settings → Database → Connection string → Transaction mode
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres — direct connection for Prisma migrations (port 5432)
# Find this in: Supabase Dashboard → Settings → Database → Connection string → Direct connection
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Postgres database for running tests (local Docker or separate Supabase project)
# Local Docker example: docker run -d -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=bridge_test -p 5432:5432 postgres:16
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bridge_test"

# Required in production — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# A warning is printed in development if this is not set; it throws in production.
JWT_SECRET=change_me_to_a_long_random_string
# Optional JWT lifetime. Default is 180d so testers do not have to re-login weekly.
AUTH_TOKEN_EXPIRES_IN=180d

# Optional: restrict CORS to a specific origin in production (default: *)
# CORS_ORIGIN=https://yourdomain.com

# Comma-separated user IDs for admin access (report review, etc.)
# ADMIN_USER_IDS=user-id-1,user-id-2
# Required for Vercel Cron authentication. Use at least 16 random characters.
CRON_SECRET=change_me_to_a_random_cron_secret

PORT=3000

# Resend email service — required for OSU email verification
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=re_your_api_key_here
# The "from" address for verification emails (must be a verified Resend domain)
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Inbox for support, abuse, and moderation report notifications
CONTACT_EMAIL=contactus@theovalapp.com
# Backend URL for signed, report-specific moderation review links
ADMIN_REPORTS_URL=https://ovalapp.vercel.app/admin/reports/review
# Required with ADMIN_REPORTS_URL. Generate a separate random 64-byte secret.
ADMIN_REVIEW_SECRET=change_me_to_a_random_admin_review_secret
# Closed safety reports are deleted after this many days (default: 730).
REPORT_RETENTION_DAYS=730
# Optional but recommended: Resend segment ID used to isolate public waitlist signups
# If set, /waitlist and /waitlist/count will only write/read from this segment
# RESEND_WAITLIST_SEGMENT_ID=seg_123456789

# Supabase Storage — for club avatar uploads
# Find SUPABASE_URL in: Supabase Dashboard → Settings → API → Project URL
# Find SUPABASE_SERVICE_ROLE_KEY in: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Required in production for text and avatar safety checks
OPENAI_API_KEY=sk_your_api_key_here
OPENAI_MODERATION_MODEL=omni-moderation-latest
# "required" fails closed if moderation is unavailable; production defaults to required.
MODERATION_ENFORCEMENT=required

# Public base URL of this API, used in emailed links (web account deletion).
# Defaults to https://api.theovalapp.com when unset.
# API_PUBLIC_URL=https://api.theovalapp.com

# Universal/App Links
IOS_APP_ID=com.bradyvb.ovalapp
APPLE_TEAM_ID=687FPU46UV
ANDROID_PACKAGE=com.theovalapp.app
# Add after the corresponding store listing exists. Until then, invite pages show
# a coming-soon message instead of a dead store link.
# IOS_APP_STORE_URL=https://apps.apple.com/us/app/oval/id1234567890
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.theovalapp.app
# Add after the Android production keystore exists.
# ANDROID_SHA256_CERT_FINGERPRINT=AA:BB:CC:...
